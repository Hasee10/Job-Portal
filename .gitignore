# Secrets — never commit these
SUPABASE_DB_Password.txt
cockroach_DB_password.txt
*.env
.env*
client_secret_*.json
cred_*.txt

# Local tool artifacts — not meant to be tracked
.playwright-mcp/

# n8n workflow exports contain hardcoded live API keys (Supabase service_role,
# Adzuna, Jooble). Keep them local only.
n8n-workflows/workflows/*.json

# Per-run scraper output, regenerated every run - not meant to be tracked.
job-scraper/run_summary.json
job-scraper/logs/

# Local-only credential migration checklist. Names and steps only, never key
# values - but keep it out of git regardless.
cred.txt

# Local Supabase env files (generated dev credentials, never production).
bordful-main/.env.local
bordful-main/.env.development.local

# Internal discussion notes. This repository is public, and these record
# meetings verbatim - colleagues by name, commercial strategy, and remarks
# that would read badly to a buyer or competitor. Keep them on disk, out of
# git: pushing one would be permanent, since history keeps it after a delete.
new_integration_discussion.txt
*_discussion.txt
