# Environment variables for bordful-main (the Next.js app). Copy this file to
# .env.local and fill in real values there - .env.local is gitignored and
# must never be committed. See the "Environment Variables" section of the
# root README.md for the full reference table this file mirrors.
#
# "Server-only" below means: read only in server components/API routes/server
# actions, never sent to the browser. Everything except NEXT_PUBLIC_APP_URL
# is server-only; Next.js only exposes a variable to client code when its
# name is prefixed NEXT_PUBLIC_.

# ---------------------------------------------------------------------------
# Supabase (required) - server-only. The service_role key bypasses Row Level
# Security; never expose it to the client or commit a real value.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ---------------------------------------------------------------------------
# NextAuth (required) - server-only. Generate AUTH_SECRET with:
#   openssl rand -base64 32
# ---------------------------------------------------------------------------
AUTH_SECRET=run_openssl_rand_base64_32_and_paste_the_output_here
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (required for job-seeker sign-in via Google). Create credentials
# at https://console.cloud.google.com/apis/credentials.
AUTH_GOOGLE_ID=your_google_oauth_client_id
AUTH_GOOGLE_SECRET=your_google_oauth_client_secret

# LinkedIn OAuth (required for job-seeker sign-in via LinkedIn). Create
# credentials at https://www.linkedin.com/developers/apps.
AUTH_LINKEDIN_ID=your_linkedin_oauth_client_id
AUTH_LINKEDIN_SECRET=your_linkedin_oauth_client_secret

# ---------------------------------------------------------------------------
# Email (required) - server-only. Gmail SMTP, not a transactional provider
# like Resend/SendGrid (see lib/email/smtp.ts for why). GMAIL_APP_PASSWORD is
# an App Password (myaccount.google.com/apppasswords), not your login
# password - it requires 2-Step Verification to be enabled on the account.
# In development, email sends are simulated as successful when these are
# unset, so this is only required for production.
# ---------------------------------------------------------------------------
GMAIL_USER=your-sender-account@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password

# ---------------------------------------------------------------------------
# App URL (required) - the only NEXT_PUBLIC_ variable here, so it is bundled
# into client-side JavaScript. Used for canonical URLs, sitemaps, and
# structured data; must match NEXTAUTH_URL above in production.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Cron authentication (required) - server-only. Bearer token the /api/cron/*
# routes require in an Authorization header. Generate any random string
# (e.g. `openssl rand -hex 32`) and set the same value as a GitHub Actions
# secret for the workflows that call these routes.
# ---------------------------------------------------------------------------
CRON_SECRET=generate_a_random_secret_here

# ---------------------------------------------------------------------------
# AI features (optional) - server-only. Powers resume matching/tailoring and
# the job-post assistant. Without any of these, those features are disabled
# rather than erroring (see lib/ai/provider.ts's isAIConfigured()).
# ---------------------------------------------------------------------------
# Up to 3 Mistral API keys, tried in order on rate-limit/auth errors -
# https://console.mistral.ai/api-keys
MISTRAL_API_KEY_1=
MISTRAL_API_KEY_2=
MISTRAL_API_KEY_3=
MISTRAL_MODEL=mistral-large-latest
# OpenRouter as a fallback if all Mistral keys are exhausted - https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# ---------------------------------------------------------------------------
# Company logos (optional) - server-only, via Logo.dev (https://logo.dev).
# Without these, job listings simply show no company logo.
# ---------------------------------------------------------------------------
LOGODEV_SECRET_KEY=
LOGODEV_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Masterclass video discovery (optional) - server-only. Without this, the
# masterclass-discovery cron finds nothing new to add.
# https://console.cloud.google.com/apis/credentials (enable the YouTube Data API v3)
# ---------------------------------------------------------------------------
YOUTUBE_API_KEY=
