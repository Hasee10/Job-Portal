# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# lockfiles - package-lock.json is committed (see below) so CI gets a
# deterministic install instead of resolving the tree fresh every run.
yarn.lock
pnpm-lock.yaml
bun.lockb

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.gstack/
