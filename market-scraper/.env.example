# Supabase (same project as job-scraper, separate market_* tables)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# CloakBrowser - used by iShopping.pk (Cloudflare-protected). Free tier needs
# no license key. Only set these if you have a paid CloakBrowser Pro plan or a proxy.
CLOAKBROWSER_LICENSE_KEY=
SCRAPER_PROXY=

# Category/collection paths to scrape per source (comma-separated)
PRICEOYE_CATEGORIES=mobiles,laptops
TELEMART_COLLECTIONS=mobiles-tablets,laptops-1
SHOPHIVE_CATEGORIES=apple/iphone,laptops
ISHOPPING_CATEGORIES=mobiles,laptops

LOG_LEVEL=info
